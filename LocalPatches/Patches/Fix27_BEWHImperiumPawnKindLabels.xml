<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Fix27: RimDark 40k - Mankinds Finest (3505068525, Phonicmas.RimDark.MankindsFinest) gives no
       label to BEWH_ImperiumTraderPawn, BEWH_ImperiumLaborerPawn and BEWH_ImperiumGuardmanPawn, or
       to their abstract bases. An Imperium trader caravan therefore breaks the vanilla caravan
       meeting letter: PawnUtility.PawnKindsToList sorts the kinds by GenLabel.BestKindLabel, which
       returns null, and the sort throws "Failed to compare two elements in the array"
       (NullReferenceException), so the incident fails (observed 2026-10-18). Any other UI that
       names the pawn kind shows nothing. Each label is added only if absent, so an upstream fix
       wins. -->
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationConditional">
        <success>Always</success>
        <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumTraderPawn"]/label</xpath>
        <nomatch Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumTraderPawn"]</xpath>
          <value>
            <label>Imperium trader</label>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <success>Always</success>
        <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumLaborerPawn"]/label</xpath>
        <nomatch Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumLaborerPawn"]</xpath>
          <value>
            <label>Imperium labourer</label>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <success>Always</success>
        <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]/label</xpath>
        <nomatch Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]</xpath>
          <value>
            <label>Imperium guardsman</label>
          </value>
        </nomatch>
      </li>
    </operations>
  </Operation>
</Patch>
