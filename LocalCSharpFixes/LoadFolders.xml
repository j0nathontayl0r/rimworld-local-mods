<?xml version="1.0" encoding="utf-8"?>
<!-- 1.6 loads the net472 build in Assemblies/; 1.7 loads only the .NET 10 build in 1.7/Assemblies.
     Never list "/" under v1.7: both DLLs would load and every patch would apply twice. -->
<loadFolders>
  <v1.6>
    <li>/</li>
  </v1.6>
  <v1.7>
    <li>1.7</li>
  </v1.7>
</loadFolders>
